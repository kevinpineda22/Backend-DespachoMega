# Copiar a `.env` en local. En Vercel se cargan como Environment Variables.
# NO commitear el `.env` real.
#
# Los nombres siguen la convencion de los demas backends de la intranet.

# ---------------------------------------------------------------------------
# Supabase (service_role — solo backend, nunca exponer al cliente)
# ---------------------------------------------------------------------------
SUPABASE_URL=

# service_role: ignora RLS y puede crear usuarios. Si se filtra, se filtra la
# base entera. Supabase -> Project Settings -> API -> service_role.
SUPABASE_SERVICE_KEY=

# ---------------------------------------------------------------------------
# Connekta API — conexion a SIESA
# ---------------------------------------------------------------------------
CONNEKTA_BASE_URL=https://servicios.siesacloud.com/api/connekta/v3
CONNEKTA_ID_COMPANIA=7375

# Consulta publicada en Siesa con los documentos de venta de los ultimos 2 dias.
# OJO: no recibe parametros — devuelve la ventana completa y el backend filtra
# por consecutivo. Si la ventana crece, conviene parametrizarla en Siesa.
CONNEKTA_CONSULTA_FACTURA=merkahorro_Despacho_Factura_dev

# Timeout y reintentos. Siesa responde vacio o con JSON truncado a veces.
CONNEKTA_TIMEOUT_MS=25000
CONNEKTA_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Credenciales Connekta/Conni
# ---------------------------------------------------------------------------
CONNI_KEY=
CONNI_TOKEN=

# ---------------------------------------------------------------------------
# Correo — TODO opcional
# ---------------------------------------------------------------------------
# Canal de RESPALDO de las novedades de inventario. El canal principal es
# Supabase Realtime, que empuja la alerta al panel del admin en el momento.
# Si algo de esto falta, el envio queda apagado y el modulo sigue funcionando.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_USER=notificacion@merkahorro.com
EMAIL_PASS=

# Destinatario de las novedades. VACIO = correo apagado, aunque el SMTP este
# completo. Es deliberado: sin destinatario explicito no sale nada, para que
# nadie empiece a recibir correos por un despliegue que no esperaba.
EMAIL_ALERTAS_INVENTARIO=

# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
PORT=3002
NODE_ENV=development

# Origenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173,https://merkahorro.com,https://www.merkahorro.com
